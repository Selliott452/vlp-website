---
import PageLayout  from '../layouts/PageLayout.astro';
import PageHero    from '../components/PageHero.astro';
import TwoPaths    from '../components/TwoPaths.astro';
import Mission     from '../components/Mission.astro';
import HowItWorks  from '../components/HowItWorks.astro';
import Spotlight   from '../components/Spotlight.astro';
import DonateBand  from '../components/DonateBand.astro';
import { siteStats, donateUrl } from '../config';
---

<PageLayout
  title="Maine Volunteer Lawyers Project"
  description="Connecting dedicated volunteer attorneys with Mainers who need free civil legal assistance, ensuring equal access to justice statewide."
>
  <main>

    <PageHero>
      <div class="hero-eyebrow">Maine's legal aid nonprofit</div>
      <h1>
        Justice shouldn't depend on your
        <em>ability to pay.</em>
      </h1>
      <p class="hero-sub">
        We connect Mainers facing civil legal challenges with dedicated volunteer
        attorneys, providing expert help to those in need, across every
        county in the state.
      </p>
      <div class="hero-actions">
        <a href="/get-help" class="btn-primary">I Need Legal Help →</a>
        <a href="/for-attorneys" class="btn-outline">Volunteer as Attorney</a>
      </div>

      <div slot="right" class="hero-stats">
        <div class="hero-stat-block">
          <h2>{siteStats.clientsServed}</h2>
          <p>Mainers helped with civil legal matters every year</p>
        </div>
        <div class="hero-stats-row">
          <div class="hero-mini-stat">
            <h3>{siteStats.countiesServed}</h3>
            <p>Maine counties served</p>
          </div>
          <div class="hero-mini-stat">
            <h3>{siteStats.yearsServing}</h3>
            <p>years serving Maine</p>
          </div>
        </div>
      </div>
    </PageHero>

    <TwoPaths />
    <div class="section-divider"></div>
    <Mission />
    <HowItWorks />
    <Spotlight />
    <DonateBand {donateUrl} />

  </main>
</PageLayout>

<style>
  .hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero-eyebrow::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--blue);
  }

  .hero-stats {
    display: flex;
    flex-direction: column;
  }
  .hero-stat-block {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(46,134,193,0.2);
    border-radius: 6px;
    padding: 40px;
    margin-bottom: 24px;
    text-align: center;
  }
  .hero-stat-block h2 {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 3.5rem;
    font-weight: 900;
    color: #fff;
    line-height: 1;
    margin-bottom: 8px;
  }
  .hero-stat-block p {
    color: rgba(255,255,255,0.65);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .hero-stats-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .hero-mini-stat {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    padding: 24px 28px;
    text-align: center;
  }
  .hero-mini-stat h3 {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 4px;
  }
  .hero-mini-stat p {
    color: rgba(255,255,255,0.5);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .hero-stat-block { padding: 28px 24px; }
    .hero-stat-block h2 { font-size: 2.8rem; }
    .hero-stats-row { gap: 12px; }
    .hero-mini-stat { padding: 18px 16px; }
    .hero-mini-stat h3 { font-size: 1.4rem; }
  }

  @media (max-width: 380px) {
    .hero-stats-row { grid-template-columns: 1fr; }
  }
</style>
