---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero   from '../components/PageHero.astro';
import { intakeUrl } from '../config';
---

<PageLayout
  title="Contact Us | Maine Volunteer Lawyers Project"
  description="Get in touch with the Maine Volunteer Lawyers Project. Find our intake line, email, and online form for requesting free civil legal help."
  activePage="Contact"
>
  <main>

    <!-- ── HERO ── -->
    <PageHero>
      <div class="eyebrow">Contact Us</div>
      <h1>We're here to help.</h1>
      <p class="hero-sub">
        Whether you need legal assistance, want to volunteer, or have a general
        inquiry, here's how to reach the right person at VLP.
      </p>
    </PageHero>

    <!-- ── CONTACT METHODS ── -->
    <section class="contact-main">
      <div class="section-inner">

        <div class="contact-grid">

          <!-- Online form -->
          <div class="contact-card primary-card">
            <div class="card-badge">Fastest response</div>
            <h2>Online Intake Form</h2>
            <p>
              The fastest way to request legal help is through our online intake form.
              A staff member will review your submission and follow up within one to
              two weeks.
            </p>
            <a href={intakeUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">
              Start Intake Form →
            </a>
          </div>

          <!-- Phone -->
          <div class="contact-card">
            <h2>Phone</h2>

            <div class="phone-entry">
              <div class="phone-region">General intake line</div>
              <a href="tel:+12075444886" class="phone-num">207-544-4886</a>
              <p class="phone-detail">
                Monday 1:00–3:30 pm &nbsp;·&nbsp; Friday 9:00–11:30 am<br />
                <em>No voicemail  -  please call during intake hours.</em>
              </p>
              <p class="phone-note">Calling may result in a longer wait time than the online form.</p>
            </div>

            <div class="phone-entry">
              <div class="phone-region">Fax</div>
              <span class="phone-num fax-num">207-221-1197</span>
            </div>
          </div>

          <!-- Email -->
          <div class="contact-card">
            <h2>Email</h2>

            <div class="email-entry">
              <div class="email-label">Intake requests</div>
              <a href="mailto:intake@vlp.org" class="email-addr">intake@vlp.org</a>
              <p class="email-detail">For individuals seeking legal assistance.</p>
              <p class="phone-note">Email may result in a longer wait time than the online form.</p>
            </div>

            <div class="email-entry">
              <div class="email-label">General inquiries</div>
              <a href="mailto:contact@vlp.org" class="email-addr">contact@vlp.org</a>
              <p class="email-detail">For media, partnerships, and all other questions.</p>
            </div>
          </div>

        </div>

        <!-- Response time notice -->
        <div class="response-note" role="note">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.8"/>
            <path d="M10 6v4M10 13v.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <p>
            It may take VLP staff <strong>one to two weeks</strong> to respond to intake requests.
            If you have an upcoming court date or deadline, please note it in your submission.
          </p>
        </div>

      </div>
    </section>

    <!-- ── FOR ATTORNEYS ── -->
    <section class="for-attorneys">
      <div class="section-inner">
        <div class="atty-inner">
          <div>
            <div class="eyebrow">Attorneys &amp; Volunteers</div>
            <h2>Interested in volunteering?</h2>
            <p>
              If you're a licensed attorney interested in volunteering with VLP,
              visit our For Attorneys page to learn about programs, eligibility,
              and how to get started.
            </p>
          </div>
          <div class="atty-actions">
            <a href="/for-attorneys" class="btn-primary">Learn About Volunteering →</a>
            <a href="mailto:contact@vlp.org" class="contact-link">or email contact@vlp.org</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SOCIAL ── -->
    <section class="social">
      <div class="section-inner">
        <h2>Follow VLP</h2>
        <div class="social-links">
          <a href="https://www.instagram.com/vlpmaine/" target="_blank" rel="noopener noreferrer" class="social-link">
            <span class="social-name">Instagram</span>
            <span class="social-handle">@vlpmaine</span>
          </a>
          <a href="https://www.facebook.com/mainevlp" target="_blank" rel="noopener noreferrer" class="social-link">
            <span class="social-name">Facebook</span>
            <span class="social-handle">mainevlp</span>
          </a>
          <a href="https://www.linkedin.com/company/maine-volunteer-lawyers-project/" target="_blank" rel="noopener noreferrer" class="social-link">
            <span class="social-name">LinkedIn</span>
            <span class="social-handle">Maine Volunteer Lawyers Project</span>
          </a>
        </div>
      </div>
    </section>

  </main>
</PageLayout>

<style>
/* ── CONTACT MAIN ── */
.contact-main {
  background: var(--cream);
  padding: 96px var(--page-padding-x);
}
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 24px;
  margin-bottom: 40px;
}
.contact-card {
  background: #fff;
  border: 1px solid var(--light-gray);
  border-radius: 6px;
  padding: 40px 36px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.primary-card {
  border-color: var(--blue);
  border-top: 3px solid var(--blue);
}
.contact-card h2 {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--navy);
}
.contact-card > p {
  font-size: 0.92rem;
  color: var(--slate);
  line-height: 1.7;
  flex: 1;
}

/* Phone */
.phone-entry {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--light-gray);
}
.phone-entry:last-of-type { border-bottom: none; padding-bottom: 0; }
.phone-region {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--blue);
}
.phone-num {
  font-family: 'Source Sans 3', sans-serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--navy);
  text-decoration: none;
  transition: color 0.2s;
}
.phone-num:hover { color: var(--blue); }
.fax-num { color: var(--navy); font-size: 1.2rem; }
.phone-detail {
  font-size: 0.82rem;
  color: var(--slate);
  line-height: 1.6;
}
.phone-detail em { color: var(--slate); opacity: 0.75; }
.phone-note {
  font-size: 0.8rem;
  color: var(--slate);
  font-style: italic;
  margin-top: auto;
}

/* Email */
.email-entry {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--light-gray);
}
.email-entry:last-of-type { border-bottom: none; padding-bottom: 0; }
.email-label {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--blue);
}
.email-addr {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--navy);
  text-decoration: none;
  transition: color 0.2s;
}
.email-addr:hover { color: var(--blue); }
.email-detail {
  font-size: 0.82rem;
  color: var(--slate);
}

/* Response note */
.response-note {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  background: var(--light-gray);
  border-left: 3px solid var(--blue);
  border-radius: 4px;
  padding: 20px 24px;
  color: var(--navy);
}
.response-note svg {
  flex-shrink: 0;
  margin-top: 1px;
  color: var(--blue);
}
.response-note p {
  font-size: 0.92rem;
  line-height: 1.65;
  color: var(--slate);
}
.response-note strong { color: var(--navy); }

/* ── FOR ATTORNEYS ── */
.for-attorneys {
  background: var(--navy);
  padding: 72px var(--page-padding-x);
}
.atty-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 48px;
  flex-wrap: wrap;
}
.for-attorneys .eyebrow { margin-bottom: 16px; }
.for-attorneys h2 {
  font-size: clamp(1.6rem, 2.5vw, 2.2rem);
  font-weight: 700;
  color: #fff;
  margin-bottom: 16px;
}
.for-attorneys p {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.7;
  max-width: 480px;
}
.atty-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
  flex-shrink: 0;
}
.contact-link {
  font-size: 0.85rem;
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  transition: color 0.2s;
}
.contact-link:hover { color: var(--blue-light); }

/* ── SOCIAL ── */
.social {
  background: var(--cream);
  padding: 72px var(--page-padding-x);
  text-align: center;
}
.social h2 {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 32px;
}
.social-links {
  display: flex;
  justify-content: center;
  gap: 24px;
  flex-wrap: wrap;
}
.social-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  background: #fff;
  border: 1px solid var(--light-gray);
  border-radius: 6px;
  padding: 24px 40px;
  text-decoration: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  min-width: 180px;
}
.social-link:hover {
  border-color: var(--blue-light);
  box-shadow: 0 4px 16px rgba(46,134,193,0.1);
}
.social-name {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--blue);
}
.social-handle {
  font-size: 0.92rem;
  color: var(--navy);
  font-weight: 500;
}

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .contact-grid { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  .contact-main,
  .for-attorneys,
  .social { padding-top: 64px; padding-bottom: 64px; }
  .atty-inner { flex-direction: column; align-items: flex-start; }
  .atty-actions { width: 100%; }
  .social-links { flex-direction: column; align-items: center; }
  .social-link { width: 100%; max-width: 320px; }
}
</style>
