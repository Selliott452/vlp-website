---
import PageLayout    from '../layouts/PageLayout.astro';
import Testimonial   from '../components/Testimonial.astro';
import { intakeUrl, testimonials } from '../config';

const practiceAreas = [
  {
    title: 'Small Claims',
    desc:  'Disputes under $10,000. Volunteer attorneys help with procedure, legal claims, and defense  -  by Zoom or phone.',
    url:   '/legal-help/small-claims',
  },
  {
    title: 'Family Matters',
    desc:  'Divorce, parental rights, child custody and support, and other family court proceedings.',
    url:   '/legal-help/family-matters',
  },
  {
    title: 'Protection From Abuse',
    desc:  'Walk-in representation at district courts for PFA orders. For immediate danger, call 9-1-1 or your local DVRC.',
    url:   '/legal-help/protection-from-abuse',
  },
  {
    title: "Workers' Rights & Employment",
    desc:  'Workplace harassment, discrimination, unpaid wages, and other employment law matters.',
    url:   '/legal-help/workers-rights',
  },
  {
    title: 'General Civil Matters',
    desc:  'Bankruptcy, benefit appeals, end-of-life planning, probate, immigrant family preparedness, and more.',
    url:   '/legal-help/general-civil',
  },
];

const referrals = [
  {
    situation: 'Facing eviction or foreclosure',
    org: 'Pine Tree Legal Assistance',
    why: 'Pine Tree Legal handles housing cases and can respond faster for eviction and foreclosure matters.',
    url: 'https://ptla.org',
  },
  {
    situation: 'Domestic violence: immediate danger',
    org: 'Your local Domestic Violence Resource Center (DVRC)',
    why: 'DVRCs provide 24/7 crisis support, safety planning, and legal advocacy for domestic violence situations.',
    url: 'https://www.mcedv.org',
  },
  {
    situation: 'Criminal charges or child protective matters',
    org: 'Maine Public Defense Service',
    why: 'VLP handles civil matters only. Criminal defense and child protective proceedings require the Maine Public Defense Service.',
    url: 'https://www.maine.gov/pds/',
  },
];

const faqs = [
  {
    q: 'Do I have to pay anything?',
    a: 'No. VLP provides free civil legal assistance. There is no cost to you for any service VLP offers.',
  },
  {
    q: 'What is a "civil" legal matter?',
    a: 'Civil legal matters include family, consumer, employment, and benefits issues, as opposed to criminal matters (being arrested or charged with a crime). VLP handles civil cases only.',
  },
  {
    q: 'How do I know if I qualify?',
    a: 'VLP helps people with limited income and assets who have a Maine legal matter or a case in a Maine court. Generally, your household income should be at or below 200% of the federal poverty level. Start an online intake and we\'ll assess your situation. Don\'t assume you don\'t qualify before reaching out.',
  },
  {
    q: 'How long does it take to hear back?',
    a: 'It may take VLP staff one to two weeks to respond to intake requests. The online intake form is the fastest path. If you have an urgent court date or deadline, note it in your intake so we can prioritize accordingly.',
  },
  {
    q: 'Can VLP handle emergency situations?',
    a: 'No. VLP cannot assist with emergency legal matters. If you are in immediate danger or have an urgent same-day legal need, please contact the appropriate organization listed in the "Need a Different Kind of Help?" section above.',
  },
  {
    q: 'Can I get help if I don\'t speak English?',
    a: 'Please reach out and let us know what language you speak. We will do our best to find an interpreter or an attorney who can communicate with you.',
  },
];
---

<PageLayout
  title="Get Free Legal Help | Maine Volunteer Lawyers Project"
  description="VLP connects Mainers who can't afford an attorney with free civil legal assistance. Learn about eligibility, what cases we handle, and how to apply."
  activePage="I Need Help"
>
  <main>

    <!-- ── HERO ── -->
    <section class="help-hero">
      <div class="hero-inner">
        <div class="eyebrow">Free Civil Legal Assistance</div>
        <h1>You don't have to face this alone.</h1>
        <p class="hero-sub">
          If you are dealing with a legal problem and can't afford a lawyer,
          VLP may be able to connect you with a volunteer attorney,
          at no cost to you.
        </p>
        <div class="hero-actions">
          <a href="#how-to-apply" class="btn-primary">
            Apply for Help
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 3v10M3 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <div class="hero-phone">
            <span class="phone-label">Or call intake</span>
            <a href="tel:+12075444886" class="phone-number">207-544-4886</a>
            <span class="phone-hours">Mon 1–3:30 pm · Fri 9–11:30 am</span>
          </div>
        </div>
      </div>

      <Testimonial quote={testimonials.client?.quote} attribution={testimonials.client?.attribution} />

      <div class="hero-gradient" aria-hidden="true"></div>
    </section>

    <!-- ── EMERGENCY NOTICE ── -->
    <div class="emergency-notice" role="alert">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M10 2L2 17h16L10 2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        <path d="M10 8v4M10 14v.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <p>
        <strong>VLP cannot assist with emergency situations.</strong>
        If you are in immediate danger or need same-day legal help, please
        <a href="#referrals">see the referrals below</a> for the right organization to contact.
      </p>
    </div>

    <!-- ── ELIGIBILITY ── -->
    <section class="eligibility">
      <div class="section-inner">
        <div class="section-header">
          <div class="eyebrow-blue">Who We Serve</div>
          <h2>Basic eligibility</h2>
        </div>

        <div class="elig-grid">
          <div class="elig-card">
            <div class="elig-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <path d="M14 3C8 3 3 8 3 14s5 11 11 11 11-5 11-11S20 3 14 3z" stroke="currentColor" stroke-width="1.8"/>
                <path d="M9 14l3 3 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3>Maine Legal Matter</h3>
            <p>Your case must involve a Maine legal matter or be heard in a Maine court. We serve all 16 counties statewide.</p>
          </div>

          <div class="elig-card">
            <div class="elig-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <rect x="4" y="7" width="20" height="15" rx="2" stroke="currentColor" stroke-width="1.8"/>
                <path d="M4 12h20" stroke="currentColor" stroke-width="1.8"/>
                <path d="M9 17h4M19 17h-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </div>
            <h3>Limited Income</h3>
            <p>Household income generally at or below 200% of the federal poverty level.</p>
          </div>

          <div class="elig-card">
            <div class="elig-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                <path d="M14 4L4 9v2c0 6 4.2 11.6 10 13 5.8-1.4 10-7 10-13V9L14 4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M10 14l3 3 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3>Civil Legal Matter</h3>
            <p>Your issue must be civil, not a criminal charge or arrest.</p>
          </div>
        </div>

        <p class="elig-note">
          These are general guidelines. Every situation is reviewed individually.
          If you're unsure, please reach out.
        </p>
      </div>
    </section>

    <!-- ── PRACTICE AREAS ── -->
    <section class="practice-areas">
      <div class="section-inner">
        <div class="section-header light">
          <div class="eyebrow">Areas of Practice</div>
          <h2>The types of cases we help with</h2>
          <p class="section-sub">
            VLP handles civil legal matters only. Select a category below
            to learn more and start an online intake form.
          </p>
        </div>

        <div class="areas-grid">
          {practiceAreas.map((area, i) => (
            <a href={area.url} class="area-card-link">
              <div class="area-card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
              <div class="area-card-body">
                <h3>{area.title}</h3>
                <p>{area.desc}</p>
              </div>
              <svg class="area-card-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 10h10M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ))}
        </div>

        <div class="areas-cta">
          <a href={intakeUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">
            Start Online Intake Form →
          </a>
          <p class="areas-note">Not sure if your situation qualifies? Contact us and we'll help you figure it out.</p>
        </div>
      </div>
    </section>

    <!-- ── REFERRALS ── -->
    <section class="referrals" id="referrals">
      <div class="section-inner">
        <div class="section-header">
          <div class="eyebrow-blue">Need a Different Kind of Help?</div>
          <h2>Cases we can't take, and who can help</h2>
          <p class="section-sub">
            Some situations are better handled by other organizations.
            If any of the following applies to you, please reach out to them directly.
          </p>
        </div>

        <div class="referral-list">
          {referrals.map(r => (
            <div class="referral-card">
              <div class="referral-situation">{r.situation}</div>
              <div class="referral-body">
                <h3>{r.org}</h3>
                <p>{r.why}</p>
                <a href={r.url} class="referral-link" target="_blank" rel="noopener noreferrer">
                  Visit {r.org} →
                </a>
              </div>
            </div>
          ))}
        </div>

        <div class="referral-footer">
          <p>Looking for more options? Browse our full directory of legal aid and community organizations.</p>
          <a href="/other-resources" class="btn-primary">View All Resources →</a>
        </div>
      </div>
    </section>

    <!-- ── HOW TO APPLY ── -->
    <section class="how-apply" id="how-to-apply">
      <div class="section-inner">
        <div class="section-header light">
          <div class="eyebrow">The Process</div>
          <h2>How to get help from VLP</h2>
        </div>

        <div class="apply-methods">

          <!-- Online form (recommended) -->
          <div class="apply-method primary-method">
            <div class="card-badge">Recommended: fastest response</div>
            <h3>Complete an Online Intake Form</h3>
            <p>
              The online intake form is the fastest way to request help.
              One form covers all case types.
            </p>
            <a href={intakeUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">
              Open Intake Form →
            </a>
          </div>

          <!-- Phone -->
          <div class="apply-method">
            <h3>Call Our Intake Line</h3>
            <p>Speak with an intake specialist during our phone hours.</p>
            <a href="tel:+12075444886" class="inline-phone">207-544-4886</a>
            <p class="method-hours">
              <strong>Hours:</strong> Monday 1:00–3:30 pm &nbsp;·&nbsp; Friday 9:00–11:30 am
            </p>
          </div>

          <!-- Email -->
          <div class="apply-method">
            <h3>Email</h3>
            <p>You can also reach our intake team by email. Note that this may result in a longer wait time than the online form.</p>
            <a href="mailto:intake@vlp.org" class="email-link">intake@vlp.org</a>
          </div>

        </div>

        <div class="response-note" role="note">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.8"/>
            <path d="M10 6v4M10 13v.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <p>
            It may take VLP staff <strong>one to two weeks</strong> to respond to intake requests.
            If you have an upcoming court date or deadline, please note it in your intake.
          </p>
        </div>
      </div>
    </section>

    <!-- ── FAQ ── -->
    <section class="faq">
      <div class="section-inner">
        <div class="section-header">
          <div class="eyebrow-blue">Questions &amp; Answers</div>
          <h2>Frequently asked questions</h2>
        </div>

        <div class="faq-list">
          {faqs.map(item => (
            <details class="faq-item">
              <summary class="faq-q">
                <span>{item.q}</span>
                <svg class="faq-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <p class="faq-a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

  </main>
</PageLayout>

<style>
/* ── HERO ── */
.help-hero {
  background: var(--navy);
  position: relative;
  padding: var(--hero-pt) var(--page-padding-x) var(--hero-pb);
  min-height: var(--hero-min-h);
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.help-hero h1 {
  font-size: clamp(2.2rem, 4.5vw, 3.6rem);
  font-weight: 700;
  color: #fff;
  line-height: 1.15;
  margin-bottom: 24px;
}
.hero-sub {
  max-width: 560px;
  margin-bottom: 48px;
}
.hero-actions {
  display: flex;
  align-items: center;
  gap: 40px;
  flex-wrap: wrap;
}
.hero-phone {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.phone-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--blue-light);
}
.phone-number {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: #fff;
  text-decoration: none;
  transition: color 0.2s;
}
.phone-number:hover { color: var(--blue-light); }
.phone-hours {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.42);
}

/* ── EMERGENCY NOTICE ── */
.emergency-notice {
  background: var(--danger);
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 18px var(--page-padding-x);
  color: #fff;
}
.emergency-notice svg {
  flex-shrink: 0;
  margin-top: 2px;
  color: #f4a78a;
}
.emergency-notice p {
  font-size: 0.92rem;
  line-height: 1.6;
}
.emergency-notice a {
  color: #f4a78a;
  text-decoration: underline;
}

/* ── PRACTICE AREAS ── */
.practice-areas {
  background: var(--navy);
  padding: 96px var(--page-padding-x);
}
.areas-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-top: 1px solid rgba(255,255,255,0.1);
  margin-bottom: 32px;
}
.area-card-link {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 28px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  text-decoration: none;
  transition: background 0.15s;
  border-radius: 4px;
  margin: 0 -16px;
}
.area-card-link:hover {
  background: rgba(255,255,255,0.04);
}
.area-card-link:hover .area-card-body h3 { color: var(--blue-light); }
.area-card-link:hover .area-card-arrow { transform: translateX(4px); color: var(--blue-light); }
.area-card-num {
  font-family: 'Playfair Display', serif;
  font-size: 1.8rem;
  font-weight: 900;
  color: rgba(255,255,255,0.12);
  line-height: 1;
  flex-shrink: 0;
  width: 48px;
  user-select: none;
}
.area-card-body {
  flex: 1;
  position: relative;
}
.area-card-body h3 {
  font-size: 1.05rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 4px;
  transition: color 0.2s;
}
.area-card-body p {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.6);
  line-height: 1.5;
}
.area-card-arrow {
  color: rgba(255,255,255,0.35);
  flex-shrink: 0;
  transition: transform 0.2s, color 0.2s;
}

.areas-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  margin-top: 8px;
}
.areas-note {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.45);
  font-style: italic;
}

/* ── REFERRALS ── */
.referrals {
  background: var(--cream);
  padding: 88px var(--page-padding-x);
}
.referral-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  max-width: 860px;
  margin: 0 auto;
  border-top: 1px solid rgba(27,79,114,0.12);
}
.referral-card {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 32px;
  padding: 36px 0;
  border-bottom: 1px solid rgba(27,79,114,0.12);
  align-items: start;
}
.referral-situation {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--blue);
  padding-top: 4px;
  line-height: 1.5;
}
.referral-body h3 {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 8px;
}
.referral-body p {
  font-size: 0.88rem;
  color: var(--slate);
  line-height: 1.65;
  margin-bottom: 12px;
}
.referral-link {
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--blue);
  text-decoration: none;
  text-transform: uppercase;
}
.referral-link:hover { text-decoration: underline; }

.referral-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
  margin-top: 40px;
}
.referral-footer p {
  font-size: 0.92rem;
  color: var(--slate);
}

/* ── ELIGIBILITY ── */
.eligibility {
  background: var(--cream);
  padding: 88px var(--page-padding-x);
}
.elig-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  max-width: 1000px;
  margin: 0 auto 28px;
}
.elig-card {
  background: #fff;
  border: 1px solid var(--light-gray);
  border-radius: 6px;
  padding: 36px 32px;
}
.elig-icon {
  color: var(--blue);
  margin-bottom: 20px;
}
.elig-card h3 {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 10px;
}
.elig-card p {
  font-size: 0.88rem;
  color: var(--slate);
  line-height: 1.65;
}
.elig-note {
  text-align: center;
  font-size: 0.85rem;
  color: var(--slate);
  font-style: italic;
  max-width: 1000px;
  margin: 0 auto;
  opacity: 0.6;
}

/* ── HOW TO APPLY ── */
.how-apply {
  background: var(--navy);
  padding: 96px var(--page-padding-x);
}
.apply-methods {
  display: flex;
  flex-direction: column;
  gap: 0;
  max-width: 740px;
  margin: 0 auto 36px;
  border-top: 1px solid rgba(255,255,255,0.08);
}
.apply-method {
  padding: 40px 0;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.primary-method {
  background: rgba(255,255,255,0.04);
  border-radius: 6px;
  border: 1px solid rgba(93,173,226,0.3) !important;
  padding: 36px;
  margin-bottom: 8px;
}
.card-badge { margin-bottom: 16px; }
.apply-method h3 {
  font-size: 1.15rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10px;
}
.apply-method > p {
  font-size: 0.92rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.7;
  margin-bottom: 20px;
}
.inline-phone {
  font-family: 'Playfair Display', serif;
  font-size: 1.3rem;
  font-weight: 700;
  color: #fff;
  text-decoration: none;
  transition: color 0.2s;
}
.inline-phone:hover { color: var(--blue-light); }
.method-hours {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.55);
  line-height: 1.6;
}
.method-hours strong { color: rgba(255,255,255,0.8); }
.email-link {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--blue-light);
  text-decoration: none;
}
.email-link:hover { text-decoration: underline; }

.response-note {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  max-width: 740px;
  margin: 0 auto;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(93,173,226,0.35);
  border-left: 3px solid var(--blue-light);
  border-radius: 4px;
  padding: 20px 24px;
  color: rgba(255,255,255,0.8);
}
.response-note svg {
  flex-shrink: 0;
  margin-top: 1px;
  color: var(--blue-light);
}
.response-note p {
  font-size: 0.92rem;
  line-height: 1.65;
}
.response-note strong { color: #fff; }

/* ── FAQ ── */
.faq {
  background: var(--light-gray);
  padding: 96px var(--page-padding-x);
}
.faq-list { max-width: 740px; margin: 0 auto; }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .area-card-link { margin: 0 -8px; padding-left: 8px; padding-right: 8px; }
}

@media (max-width: 768px) {
  .help-hero { grid-template-columns: 1fr; }
  .hero-actions { flex-direction: column; gap: 28px; align-items: flex-start; }
  .emergency-notice { padding-top: 16px; padding-bottom: 16px; }
  .practice-areas,
  .referrals,
  .eligibility,
  .how-apply,
  .faq { padding-top: 64px; padding-bottom: 64px; }
  .area-card-num { width: 32px; font-size: 1.4rem; }
  .elig-grid { grid-template-columns: 1fr; }
  .referral-card { grid-template-columns: 1fr; gap: 8px; }
  .primary-method { padding: 24px; }
  .section-header { margin-bottom: 36px; }
}
</style>
