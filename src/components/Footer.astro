---
// Footer.astro

const helpLinks = [
  { label: 'For Those Seeking Help',  href: '/get-help' },
  { label: 'Other Resources',         href: '/other-resources' },
  { label: 'Contact Us',              href: '/contact' },
];

const volLinks = [
  { label: 'For Attorneys',           href: '/for-attorneys' },
  { label: 'For Community Members',   href: '/for-community-members' },
];

const orgLinks = [
  { label: 'About VLP', href: '/about-vlp' },
  { label: 'Careers',   href: '/careers' },
  { label: 'Donate',    href: '/donate' },
];

const year = 2026; // static site: update manually each year or set up an annual rebuild
---

<footer id="contact">
  <div class="footer-top">
    <div class="footer-brand">
      <h3>Maine Volunteer Lawyers Project</h3>
      <p>
        Connecting dedicated volunteer attorneys with Mainers who need civil
        legal assistance, ensuring equal access to justice, statewide.
      </p>
    </div>

    <div class="footer-col">
      <h4>Get Help</h4>
      <ul role="list">
        {helpLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h4>How You Can Help</h4>
      <ul role="list">
        {volLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h4>Organization</h4>
      <ul role="list">
        {orgLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} Maine Volunteer Lawyers Project. All rights reserved.</span>
    <div class="social-links">
      <a href="https://www.instagram.com/vlpmaine/" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="https://www.facebook.com/mainevlp" target="_blank" rel="noopener noreferrer">Facebook</a>
      <a href="https://www.linkedin.com/company/maine-volunteer-lawyers-project/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--navy);
    color: rgba(255,255,255,0.6);
    padding: 64px var(--page-padding-x) 40px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    margin-bottom: 32px;
  }

  .footer-brand h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }
  .footer-brand p {
    font-size: 0.875rem;
    line-height: 1.65;
    max-width: 280px;
  }

  .footer-col h4 {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue-light);
    margin-bottom: 16px;
  }
  .footer-col ul { list-style: none; }
  .footer-col li { margin-bottom: 10px; }
  .footer-col a {
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--blue-light); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
  }

  .social-links { display: flex; gap: 16px; }
  .social-links a {
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .social-links a:hover { color: var(--blue-light); }

  /* Responsive */
  @media (max-width: 1024px) {
    footer { padding-top: 56px; padding-bottom: 32px; }
    .footer-top { grid-template-columns: 1fr 1fr; gap: 32px; }
  }

  @media (max-width: 768px) {
    footer { padding-top: 48px; padding-bottom: 28px; }
    .footer-top { grid-template-columns: 1fr; gap: 32px; }
    .footer-brand p { max-width: 100%; }
    .footer-bottom { flex-direction: column; gap: 16px; text-align: center; }
  }
</style>
