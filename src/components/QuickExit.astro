---
import { quickExitUrl } from '../config';
---

<button id="quick-exit" title="Click to quickly leave this site" aria-label="Quick exit: leave this site immediately">
  ⚠ Quick Exit
</button>

<style>
  #quick-exit {
    position: fixed;
    bottom: 16px;
    right: 16px;
    z-index: 9999;
    background: #c0392b;
    color: #fff;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 18px;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(192,57,43,0.35);
    transition: background 0.15s, transform 0.1s;
  }
  #quick-exit:hover { background: #a93226; transform: scale(1.03); }

  @media (max-width: 768px) {
    #quick-exit {
      font-size: 0.75rem;
      padding: 10px 16px;
    }
  }
</style>

<script define:vars={{ quickExitUrl }}>
  const btn = document.getElementById('quick-exit');
  if (btn) {
    btn.addEventListener('click', () => {
      window.location.replace(quickExitUrl);
    });
  }
</script>
