---
// PageHero.astro
// Shared hero section used across all pages.
// - Default slot      → left column (eyebrow, h1, sub, actions)
// - "right" slot      → right column (testimonial, photo, stats, etc.)
//   If no right slot is provided the hero renders single-column.
// - "background" slot → absolutely-positioned overlays (bg patterns, dividers)

interface Props {
  /** Extra CSS classes forwarded to the <section> (rarely needed) */
  class?: string;
}

const { class: className = '' } = Astro.props;
const hasRight = Astro.slots.has('right');
---

<section class:list={['page-hero', { 'page-hero--two-col': hasRight }, className]}>
  <slot name="background" />

  <div class="hero-inner">
    <slot />
  </div>

  {hasRight && (
    <div class="hero-right">
      <slot name="right" />
    </div>
  )}

  <div class="hero-gradient" aria-hidden="true"></div>
</section>

<style>
  .page-hero {
    background: var(--navy);
    position: relative;
    padding: var(--hero-pt) var(--page-padding-x) var(--hero-pb);
    overflow: hidden;
  }

  .page-hero--two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }


  /* Left column content */
  .hero-inner {
    position: relative;
    z-index: 1;
    border-right: 1px solid rgba(46, 134, 193, 0.35);
    padding-right: 64px;
    margin-right: -32px;
  }
  .hero-inner :global(h1) {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 24px;
  }
  .hero-inner :global(.hero-sub) {
    max-width: 560px;
    margin-bottom: 48px;
  }
  .hero-inner :global(.hero-actions) {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Right column */
  .hero-right {
    position: relative;
    z-index: 1;
  }

  /* Gradient overlay */
  .hero-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 100% 0%, rgba(46,134,193,0.18) 0%, transparent 60%),
      radial-gradient(ellipse 40% 60% at 0% 100%, rgba(93,173,226,0.07) 0%, transparent 50%);
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .page-hero--two-col {
      grid-template-columns: 1fr;
    }
    .hero-inner {
      border-right: none;
      padding-right: 0;
      margin-right: 0;
    }
  }
</style>
